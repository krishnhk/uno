{
  "name": "online-uno",
  "version": "1.0.0",
  "description": "Online multiplayer Uno for 2 to 6 players, with a Node.js and Socket.IO server and an Angular client",
  "main": "src/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/game.test.js test/rooms.test.js test/moments.test.js",
    "start": "node src/server.js",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "client:dev": "npm --prefix client start",
    "build": "npm run client:install && npm run client:build"
  },
  "keywords": ["uno", "card-game", "multiplayer", "socket.io", "angular"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
